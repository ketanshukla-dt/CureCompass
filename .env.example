# ── Dynatrace ──────────────────────────────────────────────────
# Your Dynatrace tenant URL (no trailing slash)
# e.g. https://abc12345.live.dynatrace.com
DT_TENANT_URL=https://YOUR_TENANT_ID.live.dynatrace.com

# Dynatrace API token — needs Problems v2 (Read) + Entities (Read) scopes
DT_API_TOKEN=your-dynatrace-api-token

# ── LLM provider ───────────────────────────────────────────────
# anthropic | bedrock | vertex | ollama   (default: anthropic)
LLM_PROVIDER=anthropic

# Model id for the chosen provider (Bedrock/Vertex use their own id formats)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# LLM_PROVIDER=bedrock  (credentials come from the standard AWS chain)
# AWS_REGION=us-east-1

# LLM_PROVIDER=vertex   (credentials come from gcloud application-default login)
# VERTEX_PROJECT_ID=your-gcp-project
# VERTEX_REGION=us-east5

# LLM_PROVIDER=ollama   (local model, no key; data never leaves your machine)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── App settings ───────────────────────────────────────────────
# Set to "true" to use mock incident data and canned AI output (no keys needed)
SIMULATION_MODE=false

# Port for the monolith server
PORT=8000

# Interface to bind. Keep 127.0.0.1 unless behind an authenticating reverse proxy.
HOST=127.0.0.1

# Extra browser origins allowed for CORS (comma-separated). Only the Vite dev server needs this.
# CORS_ORIGINS=http://localhost:5173

# SQLite file (relative paths resolve against the project root) and analysis-cache lifetime
# DATABASE_PATH=incidents.db
# ANALYSIS_CACHE_TTL_MINUTES=1440
