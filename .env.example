# ── Dynatrace ──────────────────────────────────────────────────
# Your Dynatrace tenant URL (no trailing slash)
# e.g. https://abc12345.live.dynatrace.com
DT_TENANT_URL=https://YOUR_TENANT_ID.live.dynatrace.com

# Dynatrace API token — needs Problems v2 (Read) + Entities (Read) scopes
DT_API_TOKEN=your-dynatrace-api-token

# ── Anthropic / Claude ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# ── App settings ───────────────────────────────────────────────
# Set to "true" to use mock incident data instead of live Dynatrace
SIMULATION_MODE=false

# Port for the monolith server
PORT=8000
